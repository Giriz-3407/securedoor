# Secure IoE Remote Door Access - Environment Configuration Template
# Copy this file to .env (do not commit .env to version control)

# Active Environment: development | testing | production
ENV=development

# Backend API Base URL
# - For local Android emulator: http://10.0.2.2:8080/api/v1
# - For physical Android phone on local Wi-Fi: http://192.168.1.50:8080/api/v1
# - For production cloud backend: https://api.secure-access.internal/v1
API_BASE_URL=https://api.secure-access.internal/v1

# Mock/Demo Mode (set to false when backend & ESP32 are online)
# Default is true for engineering laboratory demonstration
MOCK_MODE=true

# Request timeouts in milliseconds
REQUEST_TIMEOUT_MS=10000
COMMAND_ACK_TIMEOUT_MS=15000
